# Copy to .env and fill in the values. NEVER commit the real .env file.
# Note: n8n reads most of this configuration from its own credentials UI,
# not from this file. This template documents what you need to have ready
# before importing the workflow (see docs/credentials.md).

# --- WAHA (WhatsApp HTTP API) ---
WAHA_URL=https://YOUR-WAHA-HOST
WAHA_SESSION=default
# Header Auth header name and token configured in WAHA (docs/waha-configuration.md)
WAHA_AUTH_HEADER=X-Api-Key
WAHA_AUTH_TOKEN=CHANGE_ME

# --- n8n Webhook (must match the Webhook node "Path" after import) ---
N8N_WEBHOOK_PATH=replace-with-a-long-random-path

# --- Redis (conversation memory + business card control) ---
REDIS_HOST=CHANGE_ME
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0

# --- PostgreSQL (business card table) ---
POSTGRES_HOST=CHANGE_ME
POSTGRES_PORT=5432
POSTGRES_DATABASE=CHANGE_ME
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SCHEMA=public

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=YOUR_CALENDAR_ID
# OAuth2 client id/secret are stored as an n8n credential, not here
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME

# --- Groq (LLM) ---
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=openai/gpt-oss-120b
